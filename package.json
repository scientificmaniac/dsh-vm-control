{
  "name": "dsh-vm-control",
  "version": "1.1.1",
  "description": "VMware Workstation / Player / Fusion virtual machine control for the DeepSeek Harness — power, snapshots, live resources and network configuration",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis-plugin",
    "vmware",
    "workstation",
    "virtual-machine",
    "vmrun"
  ],
  "license": "MIT",
  "author": "scientificmaniac (https://github.com/scientificmaniac)",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scientificmaniac/dsh-vm-control.git"
  },
  "homepage": "https://github.com/scientificmaniac/dsh-vm-control#readme",
  "bugs": {
    "url": "https://github.com/scientificmaniac/dsh-vm-control/issues"
  },
  "scripts": {
    "test": "node test/unit.mjs && node test/api.mjs && node test/client-smoke.mjs && node test/ssh-vault-link.mjs",
    "test:live": "node test/live.mjs",
    "check": "node scripts/release.mjs --check-only",
    "build": "node scripts/release.mjs --check-only",
    "pack:dist": "node scripts/release.mjs --skip-tests",
    "release": "node scripts/release.mjs"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "locale",
    "cordis.patch.yml",
    "dsh-market-entry.yml",
    "icon.svg",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "CHANGELOG.zh-CN.md",
    "SECURITY.md",
    "SECURITY.zh-CN.md",
    "LICENSE"
  ],
  "icon": "./icon.svg",
  "meta": {
    "title": "VMware VM Control",
    "description": "Start, stop, pause, snapshot and reconfigure VMware virtual machines, and watch their state, resource use and network layout from one panel."
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
